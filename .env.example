# Секреты хранятся только локально. Не добавляйте .env и secrets/ в Git.
TELEGRAM_BOT_TOKEN=
# Railway: webhook. Локальный запуск: polling.
TELEGRAM_MODE=polling
# Случайный секрет вебхука (32–256 символов), отдельно от токена бота.
TELEGRAM_WEBHOOK_SECRET=
# Ваш числовой Telegram user ID. Несколько ID — через запятую.
ALLOWED_USER_IDS=

GOOGLE_SPREADSHEET_ID=16S1KKEV-8CmRLbasQN6WB1NOfUpJs9oFywIGPZXixZs
GOOGLE_SHEET_NAME=Лист1
# JSON-ключ сервисного аккаунта с доступом «Редактор» к этой таблице.
# Или оставьте пустым, если настроены Google Application Default Credentials.
GOOGLE_CREDENTIALS_FILE=secrets/google-service-account.json
# Railway: set the full JSON as a secret; it takes precedence over the file.
GOOGLE_CREDENTIALS_JSON=

# OpenAI-совместимый Chat Completions API. Укажите доступную вам модель.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# json_schema для провайдеров со строгой схемой; json_object для остальных.
LLM_RESPONSE_FORMAT=json_schema

# Для OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=google/gemini-2.5-flash
# Та же API-связка принимает Telegram Ogg/Opus, FFmpeg не требуется.
VOICE_ENABLED=true
VOICE_MODEL=google/gemini-2.5-flash
VOICE_MAX_SECONDS=180

TIMEZONE=Europe/Minsk
DATABASE_URL=postgresql://m100:m100_local@127.0.0.1:5433/m100
# Isolated PostgreSQL database for automated tests.
TEST_DATABASE_URL=postgresql://m100:m100_local@127.0.0.1:5433/m100_test

# React-страница и API работают в том же процессе, что и бот.
WEB_ENABLED=true
WEB_HOST=127.0.0.1
WEB_PORT=8765
WEB_BASE_URL=http://localhost:8765
# Автоматически открыть результат голосового в браузере этого компьютера.
WEB_AUTO_OPEN=true
WEB_DIST_PATH=web/dist

# Реальная интеграция Битрикс24: в тестовом портале создайте смарт-процесс
# «Дневные отчёты». Создайте строковое поле «Внешний ключ».
# Пока доступы не готовы, false позволяет отдельно проверять Google Sheets.
# Для полной сдачи задания включите true и проверьте обе системы.
BITRIX_ENABLED=false
BITRIX_WEBHOOK_URL=
BITRIX_ENTITY_TYPE_ID=0
# REST-имя поля: crm.item.fields, например ufCrm42ExternalKey.
BITRIX_EXTERNAL_KEY_FIELD=
# Если comments недоступно в смарт-процессе, создайте многострочную строку
# «Работы за день» и укажите её точное REST-имя из crm.item.fields.
BITRIX_REPORT_FIELD=comments

# Один запуск бота работает с одним объектом/таблицей.
PROJECT_NAME=М100 · Рабочий объект
# JSON-карты REST-имён создаёт python -m m100_bot.bitrix_workspace.
BITRIX_REPORT_FIELDS={}
BITRIX_REPORT_PENDING_STATUS=
# При true доступ задаётся реестром CRM; ALLOWED_USER_IDS больше не даёт обхода.
BITRIX_ACCESS_ENABLED=false
BITRIX_USERS_ENTITY_TYPE_ID=0
BITRIX_USERS_FIELDS={}
BITRIX_USER_ROLES={}
